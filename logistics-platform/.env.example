# ============================================================================
# SwiftLogistics Platform — Environment Configuration Template
# ============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Supabase Configuration
# ----------------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only Service Role Key (Bypasses RLS - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ----------------------------------------------------------------------------
# Paystack Online Payments
# ----------------------------------------------------------------------------
# Obtain from Paystack Dashboard -> Settings -> API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key-here
PAYSTACK_SECRET_KEY=your-paystack-secret-key-here
PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret-here

# Node Environment
NODE_ENV=development

